      <!-- Overlay counterpart of route149_sun_glare_car.xml: same route, same parked
           obstacle, but the sky is plain ClearNoon and the glare is composited onto the
           camera images instead of being rendered by CARLA. Run the two side by side to
           separate "the model can't see past a bright source" from anything else the
           low-sun lighting changes about the scene.

           anchor="actor" pins the glare to the parked car itself, at z_offset above its
           origin, so it tracks the car exactly (no azimuth keyframes, unlike the original
           file) and swallows it as the ego closes in.

           size is in METRES, not degrees, which is what makes the glare grow on approach:
           a finite anchor has a distance, so the sprite is projected like a real object of
           that size. On CAM_FRONT (focal ~1142 px) size="12" gives roughly

               100 m -> 137 px      50 m -> 274 px      30 m -> 457 px
                15 m -> 914 px (the distance the route stops at, ~57% of the frame)

           Use angular_size (degrees) instead to hold a constant apparent size. -->
      <overlays>
         <overlay type="glare" anchor="actor" role_name="scenario no lights"
                  z_offset="0.4" size="18" intensity="2.5" />
      </overlays>
      <!-- ClearNoon for the whole route: a single keyframe is set once at the start and
           never interpolated, so the lighting is identical from the first frame to the
           last and the glare is the only thing that changes across the run. -->
      <weathers>
         <weather cloudiness="15.0" fog_density="0.0" fog_distance="0.0" fog_falloff="0.2" precipitation="0.0" precipitation_deposits="0.0" route_percentage="0" scattering_intensity="1.0" mie_scattering_scale="0.0" sun_altitude_angle="75.0" sun_azimuth_angle="0.0" wetness="0.0" wind_intensity="0.35" />
      </weathers>
